rop table um_reporting.dashboard_circulation;
create table um_reporting.dashboard_circulation as 


SELECT 
	instext.instance_hrid as "Instance HRID",
	instext.title as "Title",
	ii.effective_shelving_order as "Item Effective Shelving Order",
	ie.effective_call_number as "Item Effective Call Number",
	ie.item_hrid as "Item HRID",
	ie.barcode as "Item Barcode",
	ie.status_name as "Item Status",
	ie.permanent_location_name as "Item Permanent Location",
	ie.effective_location_name as "Item Effective Location",
	ll.campus_name as "Campus",
	ll.library_name as "Library",
	li.loan_status as "Loan Status",
	li.loan_date as "Loan Date",
	li.checkout_service_point_name as "Checkout Service Point Name",
	ie.material_type_name as "Item Material Type",
	ie.permanent_loan_type_name as "Item Permanent Loan Type",
	COUNT(li.loan_id) as "Number of Loans",
	coalesce(SUM(li.renewal_count), 0) as "Number of Renewals"
--
from folio_derived.instance_ext as instext
    LEFT JOIN folio_derived.holdings_ext AS he ON instext.instance_id = he.instance_id
    LEFT JOIN folio_derived.item_ext AS ie ON he.id = ie.holdings_record_id 
	LEFT JOIN folio_derived.loans_items AS li ON ie.item_id = li.item_id and li.loan_date > DATE '2022-06-01'
	left join folio_derived.locations_libraries as ll on ie.permanent_location_id = ll.location_id 
	LEFT JOIN folio_inventory.item__t AS ii ON ie.item_id = ii.id

	
where li.loan_id is not null
group by 
	instext.instance_hrid,
	instext.title,
	ii.effective_shelving_order,
	ie.effective_call_number,
	ie.item_hrid,
	ie.barcode,
	ie.status_name,
	ie.permanent_location_name,
	ie.effective_location_name,
	ll.campus_name,
	ll.library_name,
	li.loan_status,
	li.loan_date,
	li.checkout_service_point_name,
	ie.material_type_name,
	ie.permanent_loan_type_name
	
